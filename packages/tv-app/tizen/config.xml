<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets"
        xmlns:tizen="http://tizen.org/ns/widgets"
        id="http://clautv.ai/tv-app"
        version="1.0.0">

  <tizen:application id="clautvai.app" package="clautvai" required_version="3.0"/>
  <tizen:profile name="tv"/>

  <name>clautv-ai</name>
  <description>AI chat for Samsung TV, powered by Claude API</description>

  <content src="index.html"/>
  <icon src="icon.png"/>

  <!-- Allow all outbound network connections (Claude API + relay) -->
  <access origin="*" subdomains="true"></access>

  <tizen:privilege name="http://tizen.org/privilege/internet"/>
  <tizen:privilege name="http://tizen.org/privilege/network.get"/>

  <feature name="http://tizen.org/feature/screen.size.normal.1080p"/>

</widget>
